# TRIP IN MINUTES — SIMRAN TELECALLER CONFIG
# Fill in your API keys and configuration values below.
# DO NOT COMMIT YOUR ACTUAL .ENV FILE TO VERSION CONTROL.

# LLM Config (Groq)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# STT Config (Deepgram)
DEEPGRAM_API_KEY=your_deepgram_api_key_here

# TTS Config (Cartesia)
CARTESIA_API_KEY=your_cartesia_api_key_here
CARTESIA_VOICE_ID=47f3bbb1-e98f-4e0c-92c5-5f0325e1e206

# Telephony Config (Vobiz)
VOBIZ_AUTH_ID=your_vobiz_auth_id_here
VOBIZ_AUTH_TOKEN=your_vobiz_auth_token_here
VOBIZ_FROM_NUMBER=+91xxxxxxxxxx

# Server Config
PUBLIC_URL=https://your-tunnel.trycloudflare.com
PORT=5050

# Timeout Settings
DEMO_REPLY_TIMEOUT_SECONDS=30.0
DEMO_TTS_TIMEOUT_SECONDS=15.0
